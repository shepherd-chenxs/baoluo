# 统一换行符规则：仓库内一律存 LF，与各人 core.autocrlf 设置无关
* text=auto eol=lf

# NSIS 安装脚本与批处理必须是 CRLF，否则 makensis / cmd 解析出错
*.nsh text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
