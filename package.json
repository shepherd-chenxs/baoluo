{
  "name": "baoluo",
  "productName": "宝螺",
  "version": "0.9.0",
  "private": true,
  "description": "宝螺 - 对话视频生成 · 语音合成 · 文案工具",
  "author": "Baoluo contributors",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepherd-chenxs/baoluo.git"
  },
  "bugs": {
    "url": "https://github.com/shepherd-chenxs/baoluo/issues"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c auto \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "bump": "npm version --no-git-tag-version --allow-same-version",
    "postinstall": "node scripts/setup-whisper.cjs && node scripts/setup-python.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:genie": "node scripts/test-genie-install-env.cjs",
    "test:genie-bg": "node scripts/test-genie-background.cjs",
    "test:convert": "electron scripts/test-voice-convert.cjs",
    "test:convert-clone": "electron scripts/test-voice-convert-clone.cjs",
    "test:narration": "electron scripts/test-narration-narrators.cjs",
    "test:datadir": "electron scripts/test-data-dir.cjs",
    "test:agent": "node scripts/test-agent-router.cjs",
    "test:agent-runner": "electron scripts/test-agent-runner.cjs",
    "test": "node scripts/test-parser.cjs && node scripts/test-agent-router.cjs && node scripts/test-genie-install-env.cjs && node scripts/test-genie-background.cjs",
    "test:composer": "node scripts/test-composer.cjs",
    "test:hot-pipeline": "node scripts/test-hot-pipeline.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "jsonrepair": "^3.15.0",
    "node-edge-tts": "^1.2.10",
    "opencc-js": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
